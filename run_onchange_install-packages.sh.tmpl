#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}

# Environment state hashes — changes here trigger run_onchange re-execution
# brew leaves: {{ output "brew" "leaves" | sha256sum }}
# brew casks: {{ output "brew" "list" "--cask" "-1" | sha256sum }}
# brew taps: {{ output "brew" "tap" | sha256sum }}
# brew trust: {{ output "bash" "-c" "brew trust --json v1 2>/dev/null || true" | sha256sum }}
# fisher plugins: {{ output "fish" "-c" "fisher list 2>/dev/null" | sha256sum }}

# Generate combined Brewfile in a temp file
brewfile=$(mktemp)
cat > "$brewfile" <<BREWEOF
{{ range .packages.universal.taps -}}
tap {{ . | quote | replace " " "\", \"" }}
{{ end -}}
{{ range .packages.universal.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.universal.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.universal.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{ if .isWorkComputer -}}
{{ range .packages.work.taps -}}
tap {{ . | quote | replace " " "\", \"" }}
{{ end -}}
{{ range .packages.work.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.work.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.work.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{ else -}}
{{ range .packages.private.taps -}}
tap {{ . | quote | replace " " "\", \"" }}
{{ end -}}
{{ range .packages.private.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.private.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.private.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
{{ end -}}
BREWEOF

# Trust every non-official tap referenced in the Brewfile before bundling.
# Homebrew 7 refuses to load formulae, casks and commands from untrusted taps,
# so an untrusted tap does not fail loudly — every tap-qualified entry above
# resolves to nothing (`brew info anomalyco/tap/opencode` reports no tap at
# all), `brew update` warns on every run, and a fresh machine installs the
# wrong thing or nothing. `brew trust` is idempotent and normalizes tap names
# (danielmschmidt/homebrew-tap -> danielmschmidt/tap), so the taps are derived
# from the generated Brewfile and trust stays in sync with packages.yaml
# automatically.
#
# Whole-tap trust is deliberately broader than the per-formula trust Homebrew
# suggests: packages.yaml is free to declare a package by its unqualified name
# (`vhs`, `1password-cli`), which may resolve through a tap, and per-formula
# trust would need the qualified name the declaration does not carry. The trust
# boundary here is the tap list in packages.yaml, which is reviewed anyway.
#
# Failures are reported rather than swallowed: this block spent months as a
# silent no-op because it predated `brew trust` and hid the resulting "Unknown
# command" behind `>/dev/null 2>&1 || true`. The trust-state hash in the header
# is the other half of that fix — it re-runs this script if trust is ever lost.
#
# Deliberately `if`, not `case`: this runs under the `#!/bin/bash` shebang,
# which on macOS is bash 3.2, and 3.2's parser cannot handle a case statement
# inside $(...) — it reads the first pattern's `)` as the end of the command
# substitution and dies on `;;`. Fixed in bash 4; irrelevant under the
# Homebrew bash this repo installs, which is exactly why it is easy to miss.
taps=$(grep -E '^(tap|brew|cask) ' "$brewfile" | while read -r kind name _; do
    name=${name//\"/}; name=${name%,}
    if [[ "$kind" == tap ]]; then
        echo "$name"
    elif [[ "$name" == */*/* ]]; then
        # Only owner/tap/formula references carry a tap that needs trusting.
        echo "${name%/*}"
    fi
done | sort -u)

if ! brew trust --json v1 >/dev/null 2>&1; then
    echo "WARNING: this Homebrew has no \`brew trust\`; leaving taps untrusted" >&2
else
    while read -r tap; do
        [[ -n "$tap" ]] || continue
        if ! trust_out=$(brew trust --tap "$tap" 2>&1); then
            echo "WARNING: could not trust tap $tap: $trust_out" >&2
        fi
    done <<< "$taps"

    # Trust is reconciled, not merely granted. `brew untap` leaves a dropped
    # tap's trust entry behind — only a tap *rename* invalidates it — so a tap
    # removed from packages.yaml would stay trusted forever, which is exactly
    # the trust surface that removing it was meant to shed. It also means a tap
    # trusted by hand, or by the other profile, lingers on this machine.
    #
    # There is no `brew untrust`, so this goes through Homebrew's own Trust API
    # rather than editing trust.json behind its back (it is written under a
    # lock, with permission checks). That API is internal, so a failure here
    # warns and carries on instead of breaking the apply.
    # $taps is deliberately unquoted: it is a newline-separated list and the
    # Ruby below takes the taps as ARGV.
    # shellcheck disable=SC2086
    if prune_out=$(brew ruby -e '
require "trust"
declared = ARGV.map { |n| Homebrew::Trust.target(n, type: :tap).last }
(Homebrew::Trust.trusted_entries(:tap) - declared).each do |tap|
  Homebrew::Trust.untrust!(:tap, tap)
  puts "Untrusted tap not declared in packages.yaml: #{tap}"
end
' $taps 2>&1); then
        if [[ -n "$prune_out" ]]; then
            echo "$prune_out"
        fi
    else
        echo "WARNING: could not prune tap trust: $prune_out" >&2
    fi
fi

# Install packages
{{ if .isWorkComputer -}}
export HOMEBREW_GITHUB_API_TOKEN='{{ onepasswordRead "op://gv2pj3dcyg2wxx3ahtvgdamp2e/ne2c6f2t3ytzfuzvdhxt4agmdu/password" "EI6GPO6VNJAVLGDDID3B75JI6E" }}'
{{ end -}}
brew bundle --file="$brewfile"

# Warn about and remove undeclared packages
undeclared=$(brew bundle cleanup --file="$brewfile" 2>/dev/null)
if [[ -n "$undeclared" ]]; then
    echo ""
    echo "WARNING: Removing packages not declared in packages.yaml:"
    echo "$undeclared"
    brew bundle cleanup --force --file="$brewfile"
    brew autoremove
fi

{{ if .isWorkComputer -}}
unset HOMEBREW_GITHUB_API_TOKEN
{{ end -}}
rm -f "$brewfile"

# Ensure colima runs Kubernetes (k3s) and auto-starts at login.
# The brew service runs `colima start -f`, which reads colima's persisted config,
# so we only need to enable Kubernetes in that config once — it survives restarts.
# Gate on the persisted value so a routine package change never tears down a
# running cluster; only a fresh/un-configured machine pays the provision cost.
k8s_enabled=$(awk '/^kubernetes:/{f=1} f&&/enabled:/{print $2; exit}' "$HOME/.colima/default/colima.yaml" 2>/dev/null)
if [ "$k8s_enabled" != "true" ]; then
    colima start --kubernetes --cpu 4 --memory 4
    colima stop
fi
brew services start colima

# Install Fisher plugins
{{ range .packages.universal.fisher -}}
fish -c 'fisher install {{ . | quote }}'
{{ end -}}
{{ if .isWorkComputer -}}
{{ range .packages.work.fisher -}}
fish -c 'fisher install {{ . | quote }}'
{{ end -}}
{{ else -}}
{{ range .packages.private.fisher -}}
fish -c 'fisher install {{ . | quote }}'
{{ end -}}
{{ end -}}

# Remove undeclared Fisher plugins
fish -c '
set expected {{ range .packages.universal.fisher }}{{ . | quote }} {{ end }}{{ if .isWorkComputer }}{{ range .packages.work.fisher }}{{ . | quote }} {{ end }}{{ else }}{{ range .packages.private.fisher }}{{ . | quote }} {{ end }}{{ end }}
if test (count $expected) -gt 0
    set expected_lower
    for e in $expected
        set -a expected_lower (string lower $e)
    end
    for plugin in (fisher list)
        if not contains -- (string lower $plugin) $expected_lower
            echo "WARNING: Removing undeclared Fisher plugin: $plugin"
            fisher remove $plugin
        end
    end
end
'

{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Unfortunately I did not yet find a way to order scripts so I'm inlining this. Should all be pretty much a no-op anyways.
# We use the version of the secret to determine if we need to update the secret
# This needs to be kept in sync with the .gitconfig file
# Secret version: {{ (onepassword "okuhh55hdfabbnwvgzomsywrxe" "gv2pj3dcyg2wxx3ahtvgdamp2e" "EI6GPO6VNJAVLGDDID3B75JI6E").version }}

# Early abort if the key is already added
if gpg --list-secret-keys | grep -q {{ onepasswordRead "op://gv2pj3dcyg2wxx3ahtvgdamp2e/okuhh55hdfabbnwvgzomsywrxe/id" "EI6GPO6VNJAVLGDDID3B75JI6E" }}; then
    echo "GPG key is present already"
else
    # EOF the key into a temporary file

    tmpDir=$(mktemp -d)
    tmpFile="${tmpDir}/private.key"

    # Manually use the onepassword command to get the file
    op read --out-file $tmpFile op://gv2pj3dcyg2wxx3ahtvgdamp2e/okuhh55hdfabbnwvgzomsywrxe/gmail.key --account "EI6GPO6VNJAVLGDDID3B75JI6E"

    # Import the key
    gpg --import $tmpFile
fi

# Also inlined sub-script depending on a dependency

# hash of the mise config file, used to determine if we need to rerun this script
# mise/config.toml hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

fish -c 'mise install -y'

{{ if .isWorkComputer -}}
# Install Pi packages after Mise makes the Pi CLI available.
{{ range .packages.work.pi -}}
{{ if hasPrefix "./" . -}}
# Local Pi packages are managed by chezmoi and loaded from settings.json.
{{ else -}}
pi install {{ . | quote }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ end -}}

fish -c "tide configure --auto --style=Rainbow --prompt_colors='True color' --show_time='24-hour format' --rainbow_prompt_separators=Angled --powerline_prompt_heads=Sharp --powerline_prompt_tails=Flat --powerline_prompt_style='Two lines, character and frame' --prompt_connection=Disconnected --powerline_right_prompt_frame=No --prompt_connection_andor_frame_color=Light --prompt_spacing=Sparse --icons='Few icons' --transient=No" > /dev/null 2>&1

# fish -c 'sudo xcodebuild -license'
