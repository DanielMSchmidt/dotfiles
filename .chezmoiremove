# Targets to delete from $HOME on apply.
#
# Ghostty loads ~/.config/ghostty/config AND the macOS-native
# ~/Library/Application Support/com.mitchellh.ghostty/config, then merges them.
# Keeping both duplicated every list-valued key — `ghostty +show-config` showed
# font-family twice — and let the two copies drift, so the split-navigation
# keybinds only ever reached one of them. ~/.config/ghostty/config is the single
# source now; this drops the leftover copy.
Library/Application Support/com.mitchellh.ghostty/config

# espanso, replaced by vicinae's built-in snippets. Dropping the source files
# alone would leave both of these behind, since chezmoi does not delete what it
# merely stopped managing. The second is the symlink that pointed at the first.
.config/espanso
Library/Application Support/espanso

# The work-only pi package, on private machines. .chezmoiignore stops chezmoi
# managing it, but an earlier apply had already deployed it — and chezmoi never
# deletes what it merely stopped managing.
{{ if not .isWorkComputer }}
.pi/agent/packages/terraform-workflow
{{ end }}
