     });
     let user_info = Box::into_raw(callback_data) as *mut c_void;
 
@@ -173,6 +195,16 @@ pub fn global_handler(sender: ExtSender, targets: Vec<Shortcut>) -> Result<Event
 
     CGEvent::tap_enable(&tap_port, true);
 
+    // Hand the port to the callback so it can re-arm the tap if macOS disables it.
+    // SAFETY: `user_info` is the CallbackData leaked above, and it is only freed in
+    // EventTapHandle::drop, which disables the tap first.
