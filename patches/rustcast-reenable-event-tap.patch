@@ -58,6 +61,22 @@ extern "C-unwind" fn keyboard_event_callback(
 
     let data = unsafe { &*(user_info as *const CallbackData) };
 
+    // macOS switches an active tap off if this callback is slow to return, or if the
+    // user disables it. The tap stays off until it is explicitly re-armed, so without
+    // this every hotkey dies silently until rustcast is restarted.
+    if matches!(
+        event_type,
+        CGEventType::TapDisabledByTimeout | CGEventType::TapDisabledByUserInput
+    ) {
+        let tap_port = data.tap_port.load(Ordering::Acquire);
+        if !tap_port.is_null() {
+            log::warn!("Event tap disabled by the system ({event_type:?}), re-enabling");
+            // SAFETY: the port outlives the callback data it is stored beside.
+            CGEvent::tap_enable(unsafe { &*tap_port }, true);
+        }
+        return unsafe { event.as_mut() };
+    }
+
     let key_code: u16 = unsafe {
         CGEvent::integer_value_field(Some(event.as_ref()), CGEventField::KeyboardEventKeycode)
     } as u16;
