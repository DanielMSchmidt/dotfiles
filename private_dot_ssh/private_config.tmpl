# colima/Lima appends this include itself on `colima start`. Keeping it here —
# with the same absolute path colima writes, so colima recognises it and does
# not add a duplicate — stops ~/.ssh/config drifting from this source. A missing
# include file is ignored by ssh, so this is harmless without colima installed.
Include {{ .chezmoi.homeDir }}/.colima/ssh_config

Host nuc
       HostName 192.168.178.83
       User admin
       IdentityFile ~/.ssh/id_rsa
       IdentityAgent none
       StrictHostKeyChecking accept-new

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"