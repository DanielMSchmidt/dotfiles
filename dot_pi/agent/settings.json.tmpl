{
  "externalEditor": "vim",
  "enableInstallTelemetry": false{{ if .isWorkComputer }},
  "defaultProvider": "bedrock-mantle",
  "defaultModel": "openai.gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "packages": [{{ range $i, $package := .packages.work.pi }}{{ if $i }}, {{ end }}{{ $package | quote }}{{ end }}],
  "enabledModels": [
    "bedrock-mantle/openai.gpt-5.6-terra",
    "bedrock-mantle/openai.gpt-5.6-sol",
    "bedrock-mantle/openai.gpt-5.6-luna"
  ]{{ end }},
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  }
}
