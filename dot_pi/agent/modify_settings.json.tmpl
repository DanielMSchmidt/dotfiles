#!/bin/sh
# chezmoi modify_ script for ~/.pi/agent/settings.json.
#
# pi co-owns this file: it writes runtime state (`theme`, `lastChangelogVersion`)
# and rewrites `packages` on `pi install`/`pi config`. A plain template would
# assert the whole file and clobber pi's runtime keys on every `chezmoi apply`,
# so pi re-adds them and the two churn forever ("has changed since chezmoi last
# wrote it").
#
# Instead we MERGE: chezmoi pipes the current file in on stdin; we override only
# the keys we declare here and preserve everything else pi wrote. jq's `. + {…}`
# keeps existing keys in place and appends genuinely-new ones, so pi's keys stay
# put. stdout replaces the target file.
set -eu

current="$(cat)"
[ -n "$current" ] || current='{}'

printf '%s' "$current" | jq '. + {
  "externalEditor": "vim",
  "enableInstallTelemetry": false,
{{- if .isWorkComputer }}
  "defaultProvider": "bedrock-mantle",
  "defaultModel": "openai.gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "packages": [{{ range $i, $p := .packages.work.pi }}{{ if $i }}, {{ end }}{{ $p | quote }}{{ end }}],
  "enabledModels": ["bedrock-mantle/openai.gpt-5.6-terra", "bedrock-mantle/openai.gpt-5.6-sol", "bedrock-mantle/openai.gpt-5.6-luna"],
{{- else }}
  "defaultProvider": "ollama",
  "defaultModel": "qwen3.5:9b",
  "packages": [{{ range $i, $p := .packages.private.pi }}{{ if $i }}, {{ end }}{{ $p | quote }}{{ end }}],
  "enabledModels": ["ollama/qwen3.5:9b", "ollama/qwen2.5-coder:3b"],
{{- end }}
  "compaction": {
    "enabled": true,
    "reserveTokens": {{ if .isWorkComputer }}16384{{ else }}32768{{ end }},
    "keepRecentTokens": 20000
  }
}'
