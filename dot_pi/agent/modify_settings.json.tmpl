#!/bin/sh
# chezmoi modify_ script for ~/.pi/agent/settings.json.
#
# pi co-owns this file: it writes runtime state (`theme`, `lastChangelogVersion`)
# and rewrites `packages` on `pi install`/`pi config`. A plain template would
# assert the whole file and clobber pi's runtime keys on every `chezmoi apply`,
# so pi re-adds them and the two churn forever ("has changed since chezmoi last
# wrote it").
#
# Instead we MERGE: chezmoi pipes the current file in on stdin; we override only
# the keys we declare here and preserve everything else pi wrote. jq's `. + {…}`
# keeps existing keys in place and appends genuinely-new ones, so pi's keys stay
# put. stdout replaces the target file.
set -eu

current="$(cat)"
[ -n "$current" ] || current='{}'

{{/* Local models come from .chezmoidata/packages.yaml so this file and
     models.json.tmpl cannot disagree about what exists. On work the local
     provider is *registered but not default*: the approved Copilot/Bedrock
     frontier models stay the default and Ollama is there for offline or
     keep-it-on-the-box work, selectable with pi's model picker. */}}
{{- $profile := "private" -}}
{{- if .isWorkComputer }}{{ $profile = "work" }}{{ end -}}
{{- $local := concat (index .ollamaModels "universal") (index .ollamaModels $profile) -}}

printf '%s' "$current" | jq '. + {
  "externalEditor": "vim",
  "enableInstallTelemetry": false,
{{- if .isWorkComputer }}
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "packages": [{{ range $i, $p := .packages.work.pi }}{{ if $i }}, {{ end }}{{ $p | quote }}{{ end }}],
  "enabledModels": ["github-copilot/gpt-5.6-terra", "github-copilot/gpt-5.6-sol", "github-copilot/gpt-5.6-luna", "bedrock-mantle/openai.gpt-5.6-terra", "bedrock-mantle/openai.gpt-5.6-sol", "bedrock-mantle/openai.gpt-5.6-luna"{{ range $local }}, {{ printf "ollama/%s" .id | quote }}{{ end }}],
{{- else }}
  "defaultProvider": "ollama",
  "defaultModel": {{ index .ollamaDriver "private" | quote }},
  "packages": [{{ range $i, $p := .packages.private.pi }}{{ if $i }}, {{ end }}{{ $p | quote }}{{ end }}],
  "enabledModels": [{{ range $i, $m := $local }}{{ if $i }}, {{ end }}{{ printf "ollama/%s" $m.id | quote }}{{ end }}],
{{- end }}
  "compaction": {
    "enabled": true,
    "reserveTokens": {{ if .isWorkComputer }}16384{{ else }}32768{{ end }},
    "keepRecentTokens": 20000
  }
}'
