// vicinae launcher config — managed by chezmoi.
//
// Read as JSONC (comments allowed, unknown keys ignored), but WRITTEN BACK as
// plain JSON: every change made through vicinae's settings GUI re-serializes
// this file and strips the comments below. If that happens, re-apply from here.
//
// Custom commands are NOT in this file. They live as Raycast-format script
// commands under ~/.local/share/vicinae/scripts (source:
// dot_local/share/vicinae/scripts), which vicinae scans recursively.
{
	"$schema": "https://vicinae.com/schemas/config.json",

	// ⌘Space, carried over from the previous launcher. macOS gives ⌘Space to
	// Spotlight by default, so it only reaches vicinae if Spotlight's shortcut
	// is disabled in System Settings › Keyboard › Keyboard Shortcuts.
	// NB: in vicinae's shortcut syntax "cmd"/"control" both mean ⌘ on macOS,
	// while "super"/"meta" mean ⌃. Use "cmd" here.
	"global_shortcuts": {
		"toggle": "cmd+space"
	},

	// Clipboard history is built in — no separate history daemon to configure.
	// Its global shortcut is an entrypoint shortcut, see "providers" below.
	"favorites": [
		"clipboard:history"
	],

	// Fall back to file search when nothing matches the query, instead of
	// searching files on every root query (which costs CPU).
	"search_files_in_root": false,
	"fallbacks": [
		"files:search"
	],

	// Start each launch from a blank root search rather than wherever the last
	// session left off.
	"pop_to_root_on_close": true,

	"theme": {
		"dark": {
			"name": "vicinae-dark",
			"icon_theme": "auto"
		},
		"light": {
			"name": "vicinae-dark",
			"icon_theme": "auto"
		}
	},

	"launcher_window": {
		// Opaque, no blur/liquid-glass. Set "auto" to get the platform default.
		"material": "none"
	},

	"telemetry": {
		"system_info": false
	},

	"providers": {
		"clipboard": {
			"entrypoints": {
				"history": {
					"shortcut": "cmd+shift+c"
				}
			}
		},

		// Power actions are built in and better than shelling out: "lock" calls
		// SACLockScreenImmediate() (a real lock, not "start the screensaver and
		// hope Lock Screen › Require password is Immediately"), and the rest
		// send the same loginwindow Apple Events as `tell application "System
		// Events" to shut down` — sudo-free, apps still get to save.
		//
		// The aliases are the short names carried over from the previous
		// launcher. `confirm` defaults to true on all of them; sleeping and
		// locking are cheap to undo, so they skip the dialog.
		"power": {
			"entrypoints": {
				"sleep": {
					"alias": "sleep",
					"preferences": { "confirm": false }
				},
				"lock": {
					"alias": "lock",
					"preferences": { "confirm": false }
				},
				"reboot": {
					"alias": "restart",
					"preferences": { "confirm": true }
				},
				"power-off": {
					"alias": "shutdown",
					"preferences": { "confirm": true }
				},
				"logout": {
					"alias": "logout",
					"preferences": { "confirm": true }
				}
			}
		}
	}
}
