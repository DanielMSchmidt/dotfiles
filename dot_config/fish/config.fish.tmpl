set -g theme_display_ruby no

# PATH and exported environment now come from conf.d/00-env.fish, which is
# generated from .chezmoidata/shell.yaml so bash and zsh get the same values.
# Do not add `set -x`/`fish_add_path` lines here — edit the YAML instead.

ssh-add -q ~/.ssh/id_rsa 2>/dev/null; or true

# Dancing helper
source $HOME/.config/fish/functions/atlas.fish 2>/dev/null; or true
source $HOME/.config/fish/functions/dancing.fish 2>/dev/null; or true
source $HOME/.config/fish/functions/development.fish 2>/dev/null; or true

if type -q op
    op completion fish | source
end

# Tide customisation
set --universal tide_right_prompt_items status cmd_duration context jobs direnv node python rustc ruby go gcloud distrobox toolbox terraform aws nix_shell crystal elixir zig time

{{ if .isWorkComputer -}}
# disabled for now
# eval "$(tfcdev rc)"
{{ end -}}
