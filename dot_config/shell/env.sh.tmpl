# ~/.config/shell/env.sh — POSIX environment for bash, zsh and sh.
#
# GENERATED by chezmoi from .chezmoidata/shell.yaml. Do not edit this file or
# its deployed copy; edit the YAML and re-apply. The fish equivalent is
# ~/.config/fish/conf.d/00-env.fish, generated from the same data.
#
# Sourced from ~/.profile, ~/.bashrc, ~/.bash_profile, ~/.zshenv and ~/.zshrc so
# that every way into a POSIX shell — including `zsh -c`, which is what agent
# tooling tends to use — resolves the same binaries fish does.
#
# Must stay POSIX and side-effect free: no output, no interactive prompts, no
# subprocesses. zsh does not word-split unquoted parameters, so this file uses
# only parameter expansion (never `for x in $PATH`) to stay shell-agnostic.

if [ -n "${__DOTFILES_ENV_LOADED:-}" ] && [ -z "${DOTFILES_ENV_REFRESH:-}" ]; then
    return 0
fi

# ---------------------------------------------------------------- PATH ------
# Entries are collected into a prefix first, in declared order, then spliced
# onto the front of PATH in one go and deduplicated. Building the prefix
# separately keeps the declared order intact no matter what the inherited PATH
# already contains.

__dotfiles_path_prefix=""
__dotfiles_path_add() {
    case ":${__dotfiles_path_prefix}:" in
        *":$1:"*) return 0 ;;
    esac
    __dotfiles_path_prefix="${__dotfiles_path_prefix:+$__dotfiles_path_prefix:}$1"
}

{{ if eq .chezmoi.os "darwin" -}}
{{ range .shell.path.darwin -}}
__dotfiles_path_add "{{ . }}"
{{ end -}}
{{ end -}}
{{ range .shell.path.universal -}}
__dotfiles_path_add "{{ . }}"
{{ end }}
# mise shims go ahead of everything else so node/go/rust resolve to the version
# mise pins rather than a Homebrew build. Interactive shells layer a full
# `mise activate` on top (see interactive.sh), which supersedes the shims.
if [ -d "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" ]; then
    __dotfiles_path_prefix="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims${__dotfiles_path_prefix:+:$__dotfiles_path_prefix}"
fi

PATH="${__dotfiles_path_prefix}${PATH:+:$PATH}"

# Drop duplicates, keeping the first (highest priority) occurrence of each entry.
__dotfiles_path_rest="$PATH"
__dotfiles_path_out=""
while [ -n "$__dotfiles_path_rest" ]; do
    __dotfiles_path_entry="${__dotfiles_path_rest%%:*}"
    case "$__dotfiles_path_rest" in
        *:*) __dotfiles_path_rest="${__dotfiles_path_rest#*:}" ;;
        *) __dotfiles_path_rest="" ;;
    esac
    [ -n "$__dotfiles_path_entry" ] || continue
    case ":$__dotfiles_path_out:" in
        *":$__dotfiles_path_entry:"*) continue ;;
    esac
    __dotfiles_path_out="${__dotfiles_path_out:+$__dotfiles_path_out:}$__dotfiles_path_entry"
done
PATH="$__dotfiles_path_out"
export PATH

unset __dotfiles_path_prefix __dotfiles_path_rest __dotfiles_path_out __dotfiles_path_entry
unset -f __dotfiles_path_add

{{ if eq .chezmoi.os "darwin" -}}
# The search-path half of `brew shellenv`. The HOMEBREW_* exports it also emits
# are declared in shell.yaml so fish gets them too.
export INFOPATH="/opt/homebrew/share/info${INFOPATH:+:$INFOPATH}"
[ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
{{ end }}
# --------------------------------------------------------- environment ------
{{ range .shell.env.universal -}}
export {{ .name }}="{{ .value }}"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ range .shell.env.darwin -}}
export {{ .name }}="{{ .value }}"
{{ end -}}
{{ end -}}
{{ if .isWorkComputer -}}
{{ range .shell.env.work -}}
export {{ .name }}="{{ .value }}"
{{ end -}}
{{ else -}}
{{ range .shell.env.private -}}
export {{ .name }}="{{ .value }}"
{{ end -}}
{{ end }}
# Defaults — applied only when the variable is not already set, so a single
# shell can override them. The `{{ "{{-" }}` trimming below is what keeps `${` and the
# generated variable name from colliding with Go template delimiters.
{{ range .shell.env_defaults.universal -}}
[ -n "${ {{- .name -}} :-}" ] || export {{ .name }}="{{ .value }}"
{{ end -}}
{{ if .isWorkComputer -}}
{{ range .shell.env_defaults.work -}}
[ -n "${ {{- .name -}} :-}" ] || export {{ .name }}="{{ .value }}"
{{ end -}}
{{ else -}}
{{ range .shell.env_defaults.private -}}
[ -n "${ {{- .name -}} :-}" ] || export {{ .name }}="{{ .value }}"
{{ end -}}
{{ end }}
# ------------------------------------------------------------- secrets ------
# Rendered separately at 0600 from 1Password; absent if `op` was unavailable.
if [ -r "$HOME/.config/shell/secrets.sh" ]; then
    . "$HOME/.config/shell/secrets.sh"
fi

__DOTFILES_ENV_LOADED=1
export __DOTFILES_ENV_LOADED
