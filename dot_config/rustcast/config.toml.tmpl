# --- Power / session ---------------------------------------------------------
# `pmset sleepnow` / `displaysleepnow` need no sudo. Shutdown and restart go
# through System Events (the sudo-free path; apps get a chance to save first).
# "Lock" starts the screen saver — it only actually locks if
# System Settings › Lock Screen › "Require password after screen saver begins"
# is set to Immediately.

[[shells]]
command = "pmset sleepnow"
icon_path = "/System/Applications/System Settings.app/Contents/Resources/SystemSettings.icns"
alias = "System: Sleep"
alias_lc = "sleep"

[[shells]]
command = "pmset displaysleepnow"
icon_path = "/System/Library/CoreServices/ScreenSaverEngine.app/Contents/Resources/AppIcon.icns"
alias = "System: Sleep Display"
alias_lc = "sleep display"

[[shells]]
command = "open -a ScreenSaverEngine"
icon_path = "/System/Library/CoreServices/ScreenSaverEngine.app/Contents/Resources/AppIcon.icns"
alias = "System: Lock Screen"
alias_lc = "lock"

[[shells]]
command = "osascript -e 'tell application \"System Events\" to restart'"
icon_path = "/System/Applications/System Settings.app/Contents/Resources/SystemSettings.icns"
alias = "System: Restart"
alias_lc = "restart"

[[shells]]
command = "osascript -e 'tell application \"System Events\" to shut down'"
icon_path = "/System/Applications/System Settings.app/Contents/Resources/SystemSettings.icns"
alias = "System: Shut Down"
alias_lc = "shutdown"

# --- rustcast itself ---------------------------------------------------------
# Restarting rustcast from inside rustcast: the relaunch has to outlive the
# process that spawned it. `nohup ... &` detaches it, so when pkill takes the app
# down the helper is orphaned to launchd and keeps running. It then waits for the
# old process to actually disappear (up to ~10s) before `open`, otherwise
# LaunchServices just focuses the dying instance instead of starting a new one.
# `pgrep/pkill -x` match the executable name exactly, so the helper — running as
# `sh` — never matches itself. Tested against a freshly applied config: the
# SIGTERM from pkill does *not* make rustcast flush its stale in-memory config
# over the file, so this is a safe way to pick up a `chezmoi apply`. (The file's
# mtime does move — that is the new instance re-serializing what it read.)

[[shells]]
command = "nohup sh -c 'for i in $(seq 50); do pgrep -x rustcast >/dev/null || break; sleep 0.2; done; open -a /Applications/Rustcast.app' >/dev/null 2>&1 & pkill -x rustcast"
icon_path = "/Applications/Rustcast.app/Contents/Resources/icon.icns"
alias = "Rustcast: Restart"
alias_lc = "restart rustcast"

