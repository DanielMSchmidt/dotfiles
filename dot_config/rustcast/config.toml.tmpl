# rustcast launcher config — managed by chezmoi.  rustcast v1.0 schema.
# Full options: https://github.com/MystikoLab/rustcast/wiki
#
# IMPORTANT: rustcast v1.0 deserializes this strictly — every top-level field
# below must be present or it silently falls back to defaults (dropping the
# shell commands). Keep this in sync with the app's default config if it updates.
# Go template ({{ "{{" }} ... {{ "}}" }}): the hue paths are rendered absolute
# so rustcast (launched by macOS, minimal PATH) can find the script.
# auto_update is OFF: /Applications/Rustcast.app is built from the pinned checkout in
# vendor/rustcast, which carries a local patch (the event tap is re-armed when macOS
# disables it, otherwise every hotkey dies silently). Letting rustcast update itself
# would replace that build with an upstream release and reintroduce the bug. To take a
# new upstream version: update the submodule, re-run ./.build-rustcast.sh, and re-check
# that this file still covers every top-level field the new version expects — if one is
# missing, rustcast silently falls back to defaults and drops the shell commands.

toggle_hotkey = "SUPER+SPACE"
clipboard_hotkey = "SUPER+SHIFT+C"
event_duration = 60
main_page = "blank"
start_at_login = true
window_location = "Default"
show_on_startup = true
placeholder = "Time to be productive!"
search_url = "https://www.google.com/search?q=%s"
haptic_feedback = false
cbhist = true
cbhist_paste_on_select = false
show_trayicon = true
search_dirs = ["~"]
blacklist = []
log_path = "/tmp/rustcast.log"
debounce_delay = 300
auto_update = false
restore_input_source_on_close = true

# --- Spotify (macOS AppleScript — no API credentials needed) -----------------
[[shells]]
command = "osascript -e 'tell application \"Spotify\" to playpause'"
icon_path = "/Applications/Spotify.app/Contents/Resources/AppIcon.icns"
alias = "Spotify: Play / Pause"
alias_lc = "play"

[[shells]]
command = "osascript -e 'tell application \"Spotify\" to next track'"
icon_path = "/Applications/Spotify.app/Contents/Resources/AppIcon.icns"
alias = "Spotify: Next Track"
alias_lc = "next"

[[shells]]
command = "osascript -e 'tell application \"Spotify\" to previous track'"
icon_path = "/Applications/Spotify.app/Contents/Resources/AppIcon.icns"
alias = "Spotify: Previous Track"
alias_lc = "previous"

