#!/usr/bin/env bash
{{ if eq .chezmoi.os "darwin" -}}
# Builds and installs /Applications/Rustcast.app from vendor/rustcast + patches/.
#
# rustcast is not a Homebrew cask any more: the released build never re-arms its
# CGEventTap after macOS disables it, which silently kills every hotkey until the app
# restarts. See patches/rustcast-reenable-event-tap.patch and .build-rustcast.sh.
#
# Runs after install-packages, so rustup is present by the time this needs it.
#
# Build inputs (force re-run on change):
#   submodule: {{ output "git" "-C" (joinPath .chezmoi.sourceDir "vendor" "rustcast") "rev-parse" "HEAD" | trim }}
#   patch:     {{ output "shasum" "-a" "256" (joinPath .chezmoi.sourceDir "patches" "rustcast-reenable-event-tap.patch") | trim }}
set -euo pipefail

exec {{ joinPath .chezmoi.sourceDir ".build-rustcast.sh" | quote }}
{{ end -}}
