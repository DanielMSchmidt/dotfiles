#!/usr/bin/env bash
# Registers and (re)starts the espanso background service after `chezmoi apply`.
# Re-runs whenever the espanso config below changes, so edited snippets reload.
#
# espanso config hashes (force re-run on change):
#   default.yml: {{ include "dot_config/espanso/config/default.yml" | sha256sum }}
#   base.yml:    {{ include "dot_config/espanso/match/base.yml" | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
set -euo pipefail

if ! command -v espanso >/dev/null 2>&1; then
  echo "espanso not installed yet — it installs via brew earlier in this apply."
  echo "Re-run 'chezmoi apply', or run: espanso service register && espanso start"
  exit 0
fi

# Register the launchd service (harmless if already registered).
espanso service register 2>/dev/null || true

# Start if not running, otherwise restart to pick up snippet changes.
if espanso status >/dev/null 2>&1; then
  espanso restart || true
else
  espanso start || true
fi

echo "espanso is running. If snippets don't expand, grant Accessibility permission:"
echo "  System Settings -> Privacy & Security -> Accessibility -> enable 'espanso'."
{{ end -}}
